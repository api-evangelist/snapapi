{
  "opencollection": "1.0.0",
  "info": {
    "name": "Snap Metadata Pdf API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pdf",
        "type": "folder"
      },
      "items": [
        {
          "info": {
