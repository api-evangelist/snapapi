{
  "opencollection": "1.0.0",
  "info": {
    "name": "Snap Metadata Usage API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check API usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://snap.michaelcli.com/api/usage"
          },
          "docs": "Get your current month's API usage and limits."
        }
      ]
    }
  ],
  "bundled": true
}